{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "number"
        },
        "comparator": {
          "enum": [
            "ge",
            "le"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "met": {
          "title": "Met",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "observed",
        "comparator",
        "threshold",
        "met"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "CurveRef": {
      "additionalProperties": false,
      "description": "A slice of one array in the curves file: frames [frame_start, frame_end).",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "frame_start": {
          "minimum": 0,
          "title": "Frame Start",
          "type": "integer"
        },
        "frame_end": {
          "minimum": 0,
          "title": "Frame End",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "key",
        "frame_start",
        "frame_end"
      ],
      "title": "CurveRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "supporting_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Event Ids",
          "type": "array"
        }
      },
      "required": [
        "measurements",
        "criteria"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "change",
            "passage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "anchor_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Event Id"
        },
        "rule": {
          "$ref": "#/$defs/RuleRef"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "related_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "start_s",
        "end_s",
        "rule",
        "evidence"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "InterpretationProvenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "libraries": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Libraries",
          "type": "object"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "window_s": {
          "title": "Window S",
          "type": "number"
        },
        "evaluated_range_s": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "created_at",
        "python_version",
        "libraries",
        "config",
        "window_s",
        "evaluated_range_s"
      ],
      "title": "InterpretationProvenance",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "statistic": {
          "title": "Statistic",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "curve": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurveRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "feature",
        "statistic",
        "value",
        "unit",
        "window"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Method",
      "type": "object"
    },
    "RuleRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "RuleRef",
      "type": "object"
    },
    "SkippedRule": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "title": "SkippedRule",
      "type": "object"
    },
    "SourceAnalysis": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "file_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "File Sha256",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Sha256",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "audio_file": {
          "title": "Audio File",
          "type": "string"
        },
        "audio_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Audio Sha256",
          "type": "string"
        },
        "curves_file": {
          "title": "Curves File",
          "type": "string"
        },
        "curves_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Curves Sha256",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "frame_rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Frame Rate Hz",
          "type": "number"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "content_sha256",
        "schema_version",
        "audio_file",
        "audio_sha256",
        "curves_file",
        "curves_sha256",
        "duration_s",
        "frame_rate_hz"
      ],
      "title": "SourceAnalysis",
      "type": "object"
    },
    "VocabularyEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "change",
            "passage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "label",
        "kind",
        "rule_version",
        "definition",
        "requires"
      ],
      "title": "VocabularyEntry",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "const": "song_interpretation",
      "default": "song_interpretation",
      "title": "Artifact",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "source_analysis": {
      "$ref": "#/$defs/SourceAnalysis"
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "provenance": {
      "$ref": "#/$defs/InterpretationProvenance"
    },
    "vocabulary": {
      "items": {
        "$ref": "#/$defs/VocabularyEntry"
      },
      "title": "Vocabulary",
      "type": "array"
    },
    "skipped_rules": {
      "items": {
        "$ref": "#/$defs/SkippedRule"
      },
      "title": "Skipped Rules",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "interpretations": {
      "items": {
        "$ref": "#/$defs/Interpretation"
      },
      "title": "Interpretations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_analysis",
    "method",
    "provenance",
    "vocabulary",
    "skipped_rules",
    "limitations",
    "interpretations"
  ],
  "title": "SongInterpretation v1",
  "type": "object"
}
