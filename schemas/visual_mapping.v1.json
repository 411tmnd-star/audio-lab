    "Responses": {
      "additionalProperties": false,
      "description": "Event responses, one row per event per rule, stored as columns in the numerical file.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
