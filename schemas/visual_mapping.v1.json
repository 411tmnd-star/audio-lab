        "high_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "High Value"
        },
        "degenerate": {
          "title": "Degenerate",
          "type": "boolean"
        },
        "computed_on": {
          "title": "Computed On",
          "type": "string"
        }
      },
      "required": [
        "method",
        "low",
        "high",
        "low_value",
        "high_value",
        "degenerate",
        "computed_on"
      ],
      "title": "NormalizationRecord",
      "type": "object"
    },
    "Numerical": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "arrays": {
          "items": {
            "$ref": "#/$defs/ArrayInfo"
