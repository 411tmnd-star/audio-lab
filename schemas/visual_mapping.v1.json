  "additionalProperties": false,
  "properties": {
    "artifact": {
      "const": "visual_mapping",
      "default": "visual_mapping",
      "title": "Artifact",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "engine": {
      "$ref": "#/$defs/Engine"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "profile": {
      "$ref": "#/$defs/ProfileRecord"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "timebase": {
      "$ref": "#/$defs/Timebase"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelRecord"
      },
      "title": "Channels",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleRecord"
      },
      "title": "Rules",
      "type": "array"
    },
    "responses": {
      "$ref": "#/$defs/Responses"
    },
    "numerical": {
      "$ref": "#/$defs/Numerical"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
