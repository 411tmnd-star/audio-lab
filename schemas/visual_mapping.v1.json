      "type": "object"
    },
    "InterpretationSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "file_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "File Sha256",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Sha256",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "content_sha256",
        "schema_version",
        "method_version"
      ],
      "title": "InterpretationSource",
      "type": "object"
    },
    "NormalizationRecord": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
