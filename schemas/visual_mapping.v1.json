{
  "$defs": {
    "AnalysisSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "file_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "File Sha256",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Sha256",
          "type": "string"
        },
        "audio_file": {
          "title": "Audio File",
          "type": "string"
        },
        "audio_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Audio Sha256",
          "type": "string"
        },
        "curves_file": {
          "title": "Curves File",
          "type": "string"
        },
        "curves_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Curves Sha256",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "content_sha256",
        "audio_file",
        "audio_sha256",
        "curves_file",
        "curves_sha256",
        "duration_s"
      ],
      "title": "AnalysisSource",
      "type": "object"
    },
    "ArrayInfo": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "key",
        "shape",
        "dtype",
        "description"
      ],
      "title": "ArrayInfo",
      "type": "object"
    },
    "ChannelRecord": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "behaviour": {
          "title": "Behaviour",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "combine": {
          "title": "Combine",
          "type": "string"
        },
        "smoothing": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Smoothing",
          "type": "object"
        },
        "rest": {
          "title": "Rest",
          "type": "number"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "coverage": {
          "default": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "array_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Array Key"
        },
        "valid_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Key"
        }
      },
      "required": [
        "name",
        "range",
        "meaning",
        "behaviour",
        "status",
        "combine",
        "smoothing",
        "rest",
        "rule_ids"
      ],
      "title": "ChannelRecord",
      "type": "object"
    },
    "ChannelStats": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "p95": {
          "title": "P95",
          "type": "number"
        },
        "std": {
          "title": "Std",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "mean",
        "p95",
        "std"
      ],
      "title": "ChannelStats",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
