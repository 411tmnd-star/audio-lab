          "type": "string"
        },
        "rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Rate Hz",
          "type": "number"
        },
        "n_samples": {
          "exclusiveMinimum": 0,
          "title": "N Samples",
          "type": "integer"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "sample_time": {
          "title": "Sample Time",
          "type": "string"
        },
        "feature_resampling": {
          "title": "Feature Resampling",
          "type": "string"
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
