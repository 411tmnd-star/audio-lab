{
  "$defs": {
    "AnalyzerInfo": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "measured",
            "estimated",
            "user_setting"
          ],
          "title": "Origin",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "method",
        "output",
        "confidence"
      ],
      "title": "AnalyzerInfo",
      "type": "object"
    },
    "BarEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "type": {
          "const": "bar",
          "default": "bar",
          "title": "Type",
          "type": "string"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "beats_per_bar": {
          "minimum": 1,
          "title": "Beats Per Bar",
          "type": "integer"
        }
