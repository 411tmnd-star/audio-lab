  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "time_base": {
      "$ref": "#/$defs/TimeBase"
    },
    "tempo": {
      "$ref": "#/$defs/Tempo"
    },
    "diagnostics": {
      "$ref": "#/$defs/Diagnostics"
    },
    "curves": {
      "$ref": "#/$defs/Curves"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "bar": "#/$defs/BarEvent",
            "beat": "#/$defs/BeatEvent",
            "loud_segment": "#/$defs/LoudSegmentEvent",
            "novelty_peak": "#/$defs/NoveltyPeakEvent",
            "onset": "#/$defs/OnsetEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BeatEvent"
          },
          {
            "$ref": "#/$defs/BarEvent"
          },
          {
            "$ref": "#/$defs/OnsetEvent"
          },
          {
            "$ref": "#/$defs/LoudSegmentEvent"
          },
          {
            "$ref": "#/$defs/NoveltyPeakEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source",
    "provenance",
    "time_base",
    "tempo",
    "diagnostics",
    "curves",
    "events"
  ],
  "title": "SongAnalysis v1",
  "type": "object"
}
