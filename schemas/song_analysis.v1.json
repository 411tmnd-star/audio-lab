          "title": "Unit",
          "type": "string"
        },
        "hop_length": {
          "exclusiveMinimum": 0,
          "title": "Hop Length",
          "type": "integer"
        },
        "frame_rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Frame Rate Hz",
          "type": "number"
        },
        "n_frames": {
          "exclusiveMinimum": 0,
          "title": "N Frames",
          "type": "integer"
        }
      },
      "required": [
        "hop_length",
        "frame_rate_hz",
        "n_frames"
      ],
      "title": "TimeBase",
      "type": "object"
