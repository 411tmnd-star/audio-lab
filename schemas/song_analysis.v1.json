        "grid": {
          "enum": [
            "frame",
            "beat",
            "mel"
          ],
          "title": "Grid",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "title": "Description",
