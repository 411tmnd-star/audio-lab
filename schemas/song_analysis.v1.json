        "beat_onset_ratio": {
          "title": "Beat Onset Ratio",
          "type": "number"
        },
        "phase_peak_offset": {
          "title": "Phase Peak Offset",
          "type": "number"
        },
        "tempo_scores": {
          "additionalProperties": {
            "type": "number"
