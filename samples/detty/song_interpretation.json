  "vocabulary": [
    {
      "label": "bass_entry",
      "kind": "change",
      "rule_version": "1",
      "definition": "A meaningful increase in bass activity. At a beat, the mean power of the bass band over the window after it exceeds the mean over the window before by at least min_rise_db; the band ends up at least min_after_level_db (relative to the song's loudest frame); and at least min_sustained_fraction of the later window's frames sit above the midpoint of the rise, so a single burst does not count.",
      "requires": [
        "curve:band_bass_db",
        "events:beat"
      ]
    },
    {
      "label": "energy_build",
      "kind": "passage",
      "rule_version": "1",
      "definition": "A sustained increase in measured energy. Overall loudness is smoothed over smooth_s and its slope taken. A passage starts when the slope exceeds min_slope_db_per_s and ends when it falls below end_slope_db_per_s; interruptions shorter than merge_gap_s are bridged. It counts when it lasts at least min_duration_s and loudness gains at least min_rise_db across it. A sudden jump (a rise of more than max_step_db within step_window_s) is not a build: frames around one are excluded and passages are cut there.",
      "requires": [
        "curve:rms_db"
      ]
    },
    {
      "label": "energy_drop",
      "kind": "change",
      "rule_version": "1",
      "definition": "A substantial reduction in energy. At a beat, the mean power of overall loudness over the window after it is at least min_drop_db below the mean over the window before.",
      "requires": [
        "curve:rms_db",
        "events:beat"
      ]
    },
    {
      "label": "high_energy_passage",
      "kind": "passage",
      "rule_version": "1",
      "definition": "A relatively sustained period of elevated energy. The song's own loud reference is the reference_percentile of its smoothed loudness. A passage is where smoothed loudness stays within within_db of that reference (with hysteresis), for at least min_duration_s. Only applies when the song has contrast: reference minus the 10th percentile is at least min_dynamic_range_db.",
      "requires": [
        "curve:rms_db"
      ]
    },
    {
      "label": "sparse_passage",
      "kind": "passage",
      "rule_version": "1",
      "definition": "A period of comparatively low activity. Smoothed loudness stays at least below_reference_db under the song's own loud reference (with hysteresis) for at least min_duration_s, and the onset rate over the passage is at most max_onset_ratio times the song's overall onset rate.",
      "requires": [
        "curve:rms_db",
        "analyzer:onset_detector"
      ]
    },
    {
      "label": "rhythmic_density_change",
      "kind": "change",
      "rule_version": "1",
      "definition": "A meaningful change in onset activity. At a beat, the onset rate (detected onsets per second) over the window after it differs from the rate before by at least min_abs_change, and the larger rate is at least min_ratio times the smaller (both offset by ratio_floor so a rate of zero is comparable).",
      "requires": [
        "analyzer:onset_detector",
        "events:beat"
      ]
    },
    {
      "label": "transition_candidate",
      "kind": "change",
      "rule_version": "1",
      "definition": "A possible transition supported by several features changing together. At a beat, count the channels that change across the beat: overall loudness, bass, mid and high band energy (each by at least its dB threshold), onset rate (by min abs change and ratio), and a novelty peak within novelty_tolerance_beats. It is a candidate when at least min_channels of the available channels change.",
      "requires": [
        "events:beat"
      ]
    }
  ],
  "skipped_rules": [],
  "limitations": [
    "v0.1 thresholds are provisional defaults, checked by eye on two songs only. They are not tuned for and may not hold on other genres or arrangements.",
    "No confidence is estimated. Judge each interpretation by its evidence and criteria.",
    "Changes are placed on beats of the analyzer's estimated beat grid and inherit its errors.",
    "Labels follow their operational definitions and nothing more: none of them says chorus, drop, verse, breakdown or mood."
  ],
