{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "es2022"], "module": "esnext", "moduleResolution": "bundler",
    "jsx": "preserve", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "isolatedModules": true, "noUncheckedIndexedAccess": false, "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "types/**/*.d.ts"]
}
